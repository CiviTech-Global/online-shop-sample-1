# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:1377@localhost:5432/online_shop_sample?schema=public

# JWT
JWT_SECRET=sample-change-me-in-production-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# File uploads
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_PATH=/uploads
MAX_FILE_SIZE=5242880

# Payment gateways (sandbox keys for development)
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3001/api/v1/payments/verify/zarinpal

ZIBAL_MERCHANT_ID=xxxxxxxxxxxx
ZIBAL_CALLBACK_URL=http://localhost:3001/api/v1/payments/verify/zibal

# Seed
ADMIN_SEED_PASSWORD=admin123

# SMS providers (optional; simulator is used when keys are empty)
KAVENEGAR_API_KEY=
SMS_IR_API_KEY=
SMS_SENDER_NUMBER=
